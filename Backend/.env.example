# Central Application Configuration
PROJECT_NAME="Claims Adjudication Platform"
ENV="development"
LOG_LEVEL="INFO"
SECRET_KEY="super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (SQLite for local dev, PostgreSQL for prod)
DATABASE_URL="sqlite:///./claims_adjudication.db"

# LLM & LangChain Configuration
OPENAI_API_KEY="your-openai-api-key-here"
DEFAULT_LLM_MODEL="gpt-4o"
DEFAULT_EMBEDDING_MODEL="text-embedding-3-small"

# Vector Store Paths
POLICY_VECTORSTORE_PATH="./data/vectorstores/policy_store"
PRECEDENT_VECTORSTORE_PATH="./data/vectorstores/precedent_store"

# Human In The Loop Thresholds
AUTO_APPROVAL_MAX_AMOUNT=5000.00
HIGH_COMPLEXITY_SCORE_THRESHOLD=7.0
